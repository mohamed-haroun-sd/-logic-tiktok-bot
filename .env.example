# Copy to .env on the server and fill with rotated secrets.
WEBSITE_API=http://127.0.0.1:5000
TIKTOK_BOT_TOKEN=replace-with-a-long-random-token
TIKTOK_ACCOUNT_ID=primary
TIKTOK_POLL_INTERVAL=5000
TIKTOK_QR_TTL_SECONDS=120
TIKTOK_ORDER_TIMEOUT_MS=900000
TIKTOK_DATA_DIR=/root/tiktok-bot/runtime
TIKTOK_CARD_FILE=/root/tiktok-bot/card.json
TIKTOK_PROXIES_JSON=[]
# Optional overrides:
# TIKTOK_SESSION_FILE=/root/tiktok-bot/runtime/sessions/primary.storage.json
# TIKTOK_USER_DATA_DIR=/root/tiktok-bot/runtime/sessions/primary
# TIKTOK_LOG_DIR=/root/tiktok-bot/runtime/logs
# TIKTOK_SCREENSHOT_DIR=/root/tiktok-bot/runtime/screenshots
# TIKTOK_PROCESSED_IDS_FILE=/root/tiktok-bot/runtime/processed_orders.json
