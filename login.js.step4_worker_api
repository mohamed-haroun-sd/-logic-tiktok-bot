const ts = () => new Date().toISOString().replace('T', ' ').slice(0, 19);

function log(msg) { console.log(`[${ts()}] ${msg}`); }
function warn(msg) { console.warn(`[${ts()}] ⚠️ ${msg}`); }
function err(msg, e) {
    console.error(`[${ts()}] ❌ ${msg}`);
