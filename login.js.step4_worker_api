    currentStep = 3;
    progressMsg = 'Filling card details inside iframe...';
    log('');
    log('━━━ STEP 3: Fill Card Details (PipoPay iframe) ━━━');

    try {
        if (!fs.existsSync(CARD_FILE)) {
            warn(`Card file "${CARD_FILE}" not found!`);
        } else {
            const card = JSON.parse(fs.readFileSync(CARD_FILE, 'utf8'));
            log(`   📋 Card: ${card.cardNumber ? card.cardNumber.replace(/\d{4}(?=\d{4})/g, '****') : 'N/A'}`);

            // Get the PipoPay iframe
            let pipoFrame;
            try {
                pipoFrame = await page.frameLocator('iframe[src*="pipopay"]').first();
