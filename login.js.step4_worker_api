    try{
        const r=await axios.get(WEBSITE_API+"/api/tiktok/orders/pending");
        if(r.data.ok && r.data.order){
            currentOrder=r.data.order;
            console.log("📦 New Order:",currentOrder.order_id);
            return currentOrder;
        }
    }catch(e){}
    return null;
}

async function updateOrder(data){
    if(!currentOrder)return;
    try{
        await axios.post(
            WEBSITE_API+"/api/tiktok/order/update",
            Object.assign({
                order_id:currentOrder.order_id
            },data)
        );
    }catch(e){}
}

