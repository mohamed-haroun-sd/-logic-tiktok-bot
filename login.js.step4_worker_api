}

// ── Screenshot ──
async function takeScreenshot(stepName) {
    const srcFile = path.join(SCREENSHOT_DIR, `${stepName}.png`);
    const publicFile = path.join(PUBLIC_DIR, `${stepName}.png`);
    try {
        const buffer = await page.screenshot({ type: 'png' });
        fs.writeFileSync(srcFile, buffer);
        fs.copyFileSync(srcFile, publicFile);
        log(`📸 ${stepName}.png saved (${buffer.length} bytes)`);
        return true;
    } catch (e) {
        err(`Screenshot ${stepName}`, e);
        return false;
    }
}

// ── Click helper ──
async function clickOne(selectors, label) {
    for (const sel of selectors) {
        try {
            const el = await page.locator(sel).first();
            if (await el.isVisible({ timeout: 6000 })) {
                await el.click({ force: true });
                log(`   ✅ Clicked: ${label}`);
                return true;
            }
        } catch { /* try next */ }
    }
    warn(`Could not click: ${label}`);
    return false;
}

// ── Fill field inside PipoPay iframe ──
async function fillInIframe(iframeLocator, placeholder, value, label) {
    const selectors = [
        `input[placeholder="${placeholder}"]`,
        `input[placeholder*="${placeholder.split(' ').slice(0, 2).join(' ')}" i]`,
        `input[placeholder*="${placeholder}" i]`,
        `input[name*="${placeholder.split(' ')[0]}" i]`,
    ];

    for (const sel of selectors) {
        try {
            const el = iframeLocator.locator(sel).first();
            if (await el.isVisible({ timeout: 5000 })) {
                await el.click({ force: true });
                await sleep(300);
                await el.fill('');
                await sleep(100);
                await el.type(value, { delay: 60 });
                log(`   ✅ Filled iframe field: ${label}`);
                return true;
            }
        } catch { /* try next */ }
    }
    warn(`Could not fill iframe field: ${label} (placeholder: "${placeholder}")`);
    return false;
}

// ── Dump iframe contents ──
async function dumpIframe() {
    try {
        const iframe = await page.frameLocator('iframe[src*="pipopay"]').first();
        const info = await iframe.evaluate(() => {
            const inputs = Array.from(document.querySelectorAll('input'));
            const buttons = Array.from(document.querySelectorAll('button, [role="button"]'));
            return {
                inputs: inputs.map(inp => ({
                    placeholder: inp.placeholder,
                    name: inp.name,
                    type: inp.type,
                    visible: inp.getBoundingClientRect().height > 0,
                    cls: (inp.className || '').substring(0, 50),
                })),
                buttons: buttons.map(btn => ({
                    text: (btn.textContent || '').trim().substring(0, 50),
                    cls: (btn.className || '').substring(0, 50),
                })),
                bodyLength: document.body.innerText.length,
                bodyPreview: document.body.innerText.substring(0, 300),
            };
        });
        log('   📍 INSIDE PipoPay iframe:');
        log('   📍 Body preview: ' + info.bodyPreview.substring(0, 200));
        log('   📍 Iframe Inputs:');
        info.inputs.forEach((inp, i) => log(`      ${i+1}. ph="${inp.placeholder}" name="${inp.name}" type="${inp.type}" visible=${inp.visible}`));
        log('   📍 Iframe Buttons:');
        info.buttons.forEach((btn, i) => log(`      ${i+1}. "${btn.text}" | class="${btn.cls}"`));
    } catch (e) {
        warn('Could not access iframe contents: ' + e.message);
        // Try listing all iframes
        try {
            const iframes = await page.evaluate(() =>
                Array.from(document.querySelectorAll('iframe')).map(f => ({
                    src: (f.src || '').substring(0, 120),
                    name: f.name,
                    id: f.id,
                }))
            );
            log('   📍 All iframes on page:');
            iframes.forEach((f, i) => log(`      ${i+1}. src="${f.src}" name="${f.name}" id="${f.id}"`));
        } catch {}
    }
}

