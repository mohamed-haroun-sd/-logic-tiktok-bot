[Unit]
Description=Logic TikTok Coin Recharge Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/tiktok-bot
EnvironmentFile=/root/tiktok-bot/.env
ExecStart=/usr/bin/node /root/tiktok-bot/login.js
Restart=always
RestartSec=8
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
